#!/bin/sh
# ANDRAX-NG simple init. systemd cannot run here, so services are started from init.d.
# List service names (one per line) in /etc/andrax-ng/services, then run: andrax-init [start|stop|status]
ACTION="${1:-start}"
LIST=/etc/andrax-ng/services
[ -f "$LIST" ] || { echo "no $LIST"; exit 0; }
while IFS= read -r svc; do
  case "$svc" in ''|'#'*) continue ;; esac
  if [ -x "/etc/init.d/$svc" ]; then
    echo "$ACTION $svc"
    "/etc/init.d/$svc" "$ACTION"
  else
    echo "skip $svc: /etc/init.d/$svc not found"
  fi
done < "$LIST"
